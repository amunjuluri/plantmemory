# Copy to .env and fill in. Never commit .env.

# --- Google AI auth: choose ONE ---
# (a) Gemini API key, simplest for local dev (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_ENTERPRISE=False
GOOGLE_API_KEY=

# (b) Vertex AI with Application Default Credentials
#     run: gcloud auth application-default login
# GOOGLE_GENAI_USE_ENTERPRISE=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Models (check https://ai.google.dev/gemini-api/docs/models) ---
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# --- Storage: local | firestore ---
STORE_BACKEND=local
# FIRESTORE_DATABASE=(default)
# FIRESTORE_COLLECTION=incidents

# --- Agent behaviour ---
MATCH_THRESHOLD=0.70
MATCH_MARGIN=0.06
DRAFT_THINKING_LEVEL=low
RECURRENCE_WINDOW_MONTHS=12
DEFAULT_INDUSTRY=generic
OCR_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
